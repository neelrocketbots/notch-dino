# Only the app is tracked. Everything else in this folder (specs, plans,
# mockups, founder research, tool workspaces) stays local.
/*
!/.gitignore
!/.github/
!/Package.swift
!/Package.resolved
!/Sources/
!/Tests/
!/README.md
!/LICENSE
!/scripts/
!/assets/
.DS_Store
founder/
mockups/
docs/
PRODUCT.md
DESIGN.md
